####################################
########### ALEJOIDE WEB ###########
####################################

WEB_SEND_EMAIL_FROM="contacto@alejoide.com"
WEB_SEND_EMAIL_TO="my-personal_email@gmail.com"
# Se usa en el cliente: Astro la embebe en el build (ARG del Dockerfile)
WEB_PUBLIC_EMAIL="contacto@alejoide.com"
WEB_RESEND_API_KEY=changeme
# El fetch a projects-api es server-side, por la red interna de Docker
WEB_PROJECTS_API_URL=http://projects-api:8000

####################################
########### PROJECTS API ###########
####################################

PROJECTS_API_APP_VERSION=0.1.0 # Versión que se muestra en la definición de OpenAPI
PROJECTS_API_DEV_MODE=False # True para recarga automática y docs en /docs
PROJECTS_API_CLEAR_DB_ON_STARTUP=False # True para borrar y recrear las tablas al iniciar la app

# Logging settings
PROJECTS_API_LOG_NAME=app
PROJECTS_API_LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL

# CORS settings. Varios orígenes separados por comas.
# El sitio y el panel consumen la API server-side, así que solo aplica si se expone al navegador.
PROJECTS_API_CORS_ALLOW_ORIGINS=https://alejoide.com

# URL pública desde donde el navegador carga las imágenes.
# nginx proxea https://alejoide.com/images/ → http://projects-api:8000/images/
PROJECTS_API_IMAGES_BASE_URL=https://alejoide.com/images
PROJECTS_API_MAX_IMAGE_SIZE_MB=5 # Tamaño máximo de las imágenes subidas

# Security settings
# Clave requerida (header X-API-Key) para crear, editar y ocultar proyectos.
# Compartida con projects-admin-frontend. Generar con: openssl rand -hex 32
# Si queda vacía, las operaciones de administración responden 503.
PROJECTS_API_ADMIN_API_KEY=changeme

####################################
###### PROJECTS ADMIN FRONTEND #####
####################################

# URL interna de projects-api dentro de la red de Docker.
# La API key se toma de PROJECTS_API_ADMIN_API_KEY.
PROJECTS_ADMIN_FRONTEND_PROJECTS_API_URL=http://projects-api:8000

####################################
############## NGINX ###############
####################################

NGINX_SERVER_NAME=alejoide.com

####################################
############## COMMON ##############
####################################

# Timezone
TZ=America/Argentina/Buenos_Aires
