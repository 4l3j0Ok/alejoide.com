---
import { Image } from "astro:assets";
import meImage from "../assets/images/me.webp";

const initialExperienceDate: Date = new Date(2020, 7, 19);
const experienceYears: number = Math.floor(
    (Date.now() - initialExperienceDate.getTime()) /
        (1000 * 60 * 60 * 24 * 365.25),
);
---

<header>
    <div class="content">
        <div class="item info">
            <p class="eyebrow">Hola, soy</p>
            <h1>Alejo Sarmiento</h1>
            <p class="summary">
                SRE y desarrollador de software con experiencia con más de {
                    experienceYears
                } años de experiencia en la industria tecnológica, especializado en
                backend e infraestructura de software.
            </p>
            <div class="stack">
                <span>SRE/DevOps</span>
                <span>Backend</span>
                <span>Frontend</span>
            </div>
            <div class="actions">
                <a class="spotlight-button" href="#Projects">Ver proyectos</a>
                <a class="ghost spotlight-button" href="#Contact">Contactar</a>
            </div>
        </div>
        <div class="item visual">
            <Image
                src={meImage}
                alt="Alejo Sarmiento"
                loading="eager"
                draggable="false"
            />
        </div>
    </div>
</header>

<style>
    header {
        display: flex;
        justify-content: center;
        padding-top: 6.8rem;
    }
    .content {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 2rem;
        align-items: center;
        width: var(--content-width);
        min-height: min(76vh, 760px);
    }
    .eyebrow {
        font-size: 0.8rem;
        letter-spacing: 0.09em;
        color: var(--accent);
        margin: 0;
    }
    .content h1 {
        font-size: clamp(2.4rem, 5vw, 4.4rem);
        font-weight: 700;
        margin: 0.25rem 0 0;
        line-height: 1.04;
    }
    .summary {
        font-size: clamp(1rem, 1.5vw, 1.26rem);
        max-width: 52ch;
        margin: 1rem 0 0;
    }
    .stack {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-top: 1.3rem;
    }
    .stack span {
        padding: 0.4rem 0.7rem;
        border: 1px solid var(--border-soft);
        background: var(--surface-header);
        border-radius: 999px;
        font-size: 0.82rem;
        font-family: "Cascadia Code Variable", monospace;
        color: var(--text-primary);
    }
    .actions {
        display: flex;
        gap: 0.8rem;
        margin-top: 1.55rem;
    }
    .actions a {
        padding: 0.7rem 1.1rem;
        border-radius: 0.8rem;
        border: 1px solid var(--accent-soft);
        background: transparent;
        color: var(--accent);
        font-weight: 700;
        font-size: 0.95rem;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }
    .actions a:hover {
        background: var(--accent-muted);
        border-color: var(--accent);
    }
    .actions .ghost {
        border-color: var(--border-soft);
        color: var(--text-primary);
    }
    .actions .ghost:hover {
        background: var(--accent-muted);
        border-color: var(--accent);
        color: var(--accent);
    }
    .visual {
        padding: 1.1rem;
        border-radius: 1.3rem;
        overflow: hidden;
        max-height: min(76vh, 760px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }
    .visual img {
        width: 100%;
        height: 100%;
        border-radius: 1rem;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        object-position: top;
        filter: saturate(1.2) contrast(1.03)
            drop-shadow(0px 0px 25px var(--accent-glow));
        mask-image: linear-gradient(black 80%, transparent);
        -webkit-mask-image: linear-gradient(black 80%, transparent);
        user-select: none;
        -webkit-user-drag: none;
    }
    @media (max-width: 900px) {
        header {
            padding-top: 7.8rem;
        }
        .content {
            grid-template-columns: 1fr;
            min-height: auto;
        }
        .actions {
            flex-wrap: wrap;
        }
    }
</style>
