---
import Section from "../layouts/Section.astro";
import WorkArea from "./WorkArea.astro";
import { workAreas } from "../config/workAreas";

const birthDate: Date = new Date(2001, 1, 2);
const age: number = Math.floor(
    (Date.now() - birthDate.getTime()) / (1000 * 60 * 60 * 24 * 365.25),
);
---

<Section sectionId="AboutMe" sectionTitle="Sobre mí">
    <div class="intro-grid spotlight-card">
        <p class="lead">
            Mi nombre es Alejo. Tengo {age} años y vivo en Argentina.
        </p>

        <p>
            Desde adolescente decidí orientar mis estudios hacia el mundo de la
            programación y la informática. Estudié en una escuela secundaria
            técnica con especialización en sistemas.
        </p>

        <p>
            A mediados de 2020 comencé a trabajar en Leafnoise, donde fui
            consolidándome como desarrollador backend con Python.
        </p>

        <p>
            Dos años más tarde di el salto hacia SRE/DevOps, el área que más me
            apasiona y en la que trabajo actualmente, administrando múltiples
            infraestructuras tanto internas como de clientes.
        </p>

        <p>
            Actualmente trabajo como SRE/DevOps en Leafnoise, estudio la carrera
            de Analista Programador y, en paralelo, desarrollo una amplia
            variedad de proyectos personales.
        </p>
    </div>
    <h3>Mis áreas de trabajo</h3>
    <div class="work-areas">
        {workAreas.map((area) => <WorkArea {...area} />)}
    </div>
    <style>
        .intro-grid {
            padding: 1.1rem;
            border: 1px solid var(--border-soft);
            border-radius: 1rem;
            background: var(--surface-dark);
            margin-bottom: 1.4rem;
        }
        .lead {
            font-size: 1.08rem;
            font-weight: 600;
            color: var(--text-primary);
        }
        h3 {
            margin: 0.25rem 0 1rem;
            font-size: clamp(1.3rem, 2vw, 1.7rem);
        }
        .work-areas {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }
        @media (max-width: 900px) {
            .intro-grid,
            .work-areas {
                grid-template-columns: 1fr;
            }
        }
    </style>
</Section>
